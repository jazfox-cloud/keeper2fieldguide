---
import type { MediaRecord, SourceRecord } from '../../config/schema.ts';

interface Props { media: MediaRecord; source: SourceRecord; priority?: boolean }
const { media, source, priority = false } = Astro.props;
---

<figure class="official-media" data-media-id={media.id}>
  <img
    src={media.assetPath}
    width={media.width}
    height={media.height}
    alt={media.alt}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
  <figcaption>
    <span>{media.attribution}</span>
    <a href={source.url} rel="noreferrer" target="_blank">View official source <span aria-hidden="true">↗</span></a>
  </figcaption>
</figure>

<style>
  .official-media { margin: 0; }
  img { width: 100%; height: auto; display: block; border: 1px solid var(--line); background: var(--paper); }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; padding: .75rem; border: 1px solid var(--line); border-top: 0; color: var(--muted); background: var(--paper); font-size: .8rem; }
</style>
