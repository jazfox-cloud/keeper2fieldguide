---
import { features } from '../../config/index.ts';

const measurementId = import.meta.env.PUBLIC_GA4_ID?.trim();
const analyticsEnabled = features.analytics && Boolean(measurementId);
---

{analyticsEnabled && <aside id="analytics-consent" class="analytics-consent" aria-labelledby="analytics-consent-title" hidden>
  <div>
    <strong id="analytics-consent-title">Optional analytics</strong>
    <p>Allow optional usage measurements. Advertising storage stays disabled.</p>
    <a href="/privacy/">Privacy details</a>
  </div>
  <div class="analytics-actions">
    <button id="analytics-reject" type="button">Reject</button>
    <button id="analytics-accept" type="button">Allow analytics</button>
  </div>
</aside>}

<script>
  import { features, siteConfig } from '../../config/index.ts';
  import { setupAnalyticsConsent } from '../../lib/analytics-consent.mjs';

  const measurementId = import.meta.env.PUBLIC_GA4_ID?.trim();
  if (features.analytics && measurementId) {
    setupAnalyticsConsent({
      window,
      document,
      measurementId,
      productionHost: new URL(siteConfig.origin).hostname,
      storageKey: 'game_guide_analytics_consent',
    });
  }
</script>

<style>
  .analytics-consent { position: fixed; z-index: 1000; right: 1rem; bottom: 1rem; left: 1rem; max-width: 920px; margin: auto; padding: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; border: 1px solid var(--line); border-radius: 14px; color: var(--ink); background: var(--paper); box-shadow: 0 20px 55px hsl(220 40% 2% / .65); }
  .analytics-consent[hidden] { display: none; }
  .analytics-consent strong { display: block; }
  .analytics-consent p { margin: .25rem 0 0; color: var(--muted-strong); font-size: .9rem; }
  .analytics-consent a, .analytics-actions button { min-height: 44px; display: inline-flex; align-items: center; }
  .analytics-actions { display: flex; flex: 0 0 auto; gap: .5rem; }
  .analytics-actions button { padding: .6rem .8rem; border: 1px solid var(--line); border-radius: 8px; color: var(--ink); background: var(--raised); font: inherit; font-weight: 750; cursor: pointer; }
  #analytics-accept { border-color: var(--accent); }
  @media (max-width: 680px) { .analytics-consent { align-items: stretch; flex-direction: column; } .analytics-actions { display: grid; grid-template-columns: 1fr 1fr; } .analytics-actions button { justify-content: center; } }
</style>
