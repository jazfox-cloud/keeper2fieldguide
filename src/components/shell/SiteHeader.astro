---
import { navigation, routes, siteConfig } from '../../config/index.ts';

const publishedPaths = new Set(routes.filter((route) => route.published).map((route) => route.path));
const visibleNavigation = navigation.filter((item) => publishedPaths.has(item.href));
const analyticsItemForPath = (href: string) => href === '/' ? 'home' : href.split('/').filter(Boolean).at(-1) ?? 'home';
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <img src={siteConfig.brand.logoPath} alt="" width="36" height="36" />
      <span>{siteConfig.shortName}</span>
    </a>
    <nav class="primary-navigation" aria-label="Primary navigation">
      {visibleNavigation.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined} data-analytics-item={analyticsItemForPath(item.href)}>{item.label}</a>)}
    </nav>
  </div>
</header>
